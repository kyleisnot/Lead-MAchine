# ── Copy this file to ".env" and fill in your real values ──

# Apify (https://console.apify.com/account/integrations)
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxx

# Which Apify actors to use (defaults are the common public ones)
APIFY_MAPS_ACTOR=compass/crawler-google-places
APIFY_FACEBOOK_ACTOR=apify/facebook-pages-scraper
# Posts scraper — used by the FB deep-check to read a page's real LAST-POST date (freshness).
APIFY_FACEBOOK_POSTS_ACTOR=apify/facebook-posts-scraper
APIFY_INSTAGRAM_ACTOR=apify/instagram-scraper

# ── Activity filter: only keep businesses active recently ──
# Absolute cutoff date (e.g. 2025-01-01) — keep only leads whose newest post/review is on/after it.
# Takes precedence over ACTIVE_WITHIN_DAYS. Leave blank to use the rolling window instead.
ACTIVE_SINCE=2025-01-01
ACTIVE_WITHIN_DAYS=0            # rolling window in days (used only when ACTIVE_SINCE is blank). 0 = off.
FRESHNESS_MODE=filter          # filter = drop stale leads · label = just tag, never drop
FRESHNESS_STRICT=true          # true = also drop leads we can't date · false = keep undated ones
# Deep-checks: spend extra Apify credits during search to date FB (recent posts) + Google (newest review).
FB_DEEP_CHECK=true
GOOGLE_DEEP_CHECK=true

# ── Spend guardrail ──
# Hard monthly Apify ceiling (USD). When this month's Apify spend is at/over this,
# new searches are blocked in the dashboard. Blank or 0 = no cap.
APIFY_MONTHLY_CAP=
# Rough $ per 1,000 places scanned — used ONLY for the pre-run cost estimate in the UI.
APIFY_RATE_PER_1K=4

# ── Claude (AI photo curation — picks the right photos for each preview) ──
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Model: claude-opus-4-8 (best) or claude-haiku-4-5 (cheaper). Leave blank for default.
CLAUDE_MODEL=claude-opus-4-8

# The Gmail address you'll send previews FROM
SENDER_EMAIL=kylecantrell65@gmail.com
# How you sign off in the cold email
SENDER_NAME=Kyle
# Your business name + a physical mailing address — REQUIRED in the email footer for US
# commercial email (CAN-SPAM). Leave SENDER_ADDRESS blank only if you're not sending in the US.
SENDER_BUSINESS=Avanzta Contractor Marketing Group
SENDER_ADDRESS=
# Max outreach emails per rolling 24h (protects your Gmail from spam throttling). 0 = no cap.
GMAIL_DAILY_CAP=40

# Local dashboard port
PORT=4000

# ── Cloudflare Pages (free preview hosting) ──
# Token: Cloudflare dashboard → My Profile → API Tokens → Create Token
#        → use the "Cloudflare Pages: Edit" template.
CLOUDFLARE_API_TOKEN=
# Account ID: Cloudflare dashboard → Workers & Pages → right sidebar "Account ID"
CLOUDFLARE_ACCOUNT_ID=
# Pages project name (lowercase, dashes). Leave as-is unless you want a different one.
CF_PAGES_PROJECT=lead-machine-previews
# Public base URL for preview links in emails. After your first deploy this is:
#   https://<CF_PAGES_PROJECT>.pages.dev
PUBLIC_BASE_URL=https://lead-machine-previews.pages.dev

# OpenAI (AI before/after image generation) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
